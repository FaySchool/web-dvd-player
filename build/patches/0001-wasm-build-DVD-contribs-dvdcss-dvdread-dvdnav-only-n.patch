 extras/package/wasm-emscripten/build.sh       |   7 +-
 7 files changed, 133 insertions(+), 6 deletions(-)
 create mode 100644 contrib/src/dvdcss/0001-emscripten-no-ioctls.patch
 create mode 100644 contrib/src/dvdread/0001-emscripten-bswap.patch

