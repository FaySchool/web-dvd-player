Date: Wed, 18 Nov 2026 16:14:26 +0000
Subject: [PATCH 3/6] emscripten window: forward mouse events from JS (DVD menu
 clicks)

---
 modules/video_output/emscripten.cpp | 50 ++++++++++++++++++++++++++---
 1 file changed, 46 insertions(+), 4 deletions(-)

diff --git a/modules/video_output/emscripten.cpp b/modules/video_output/emscripten.cpp
index e22342e..0701be1 100644
--- a/modules/video_output/emscripten.cpp
+++ b/modules/video_output/emscripten.cpp
@@ -26,6 +26,7 @@
 #endif
 
 #include <cstdarg>
+#include <mutex>
 #include <new>
 #include <string>
 
@@ -47,10 +48,43 @@
 // eglGetProcAddress
 #include <EGL/egl.h>
 
-static const struct vout_window_operations ops = {
-    //TODO: Implement canvas operations
-    //vout_window_ReportSize() should be called from here
-};
+/* The window currently displayed on the page canvas. Used to forward
+ * mouse events from JS (e.g. to click DVD menu buttons). */
+static std::mutex current_window_lock;
+static vout_window_t *current_window = nullptr;
+
+static void DestroyWindow(vout_window_t *wnd)
+{
+    current_window_lock.lock();
+    if (current_window == wnd)
+        current_window = nullptr;
+    current_window_lock.unlock();
+}
+
+static struct vout_window_operations ops;
+
+/* Called from JS with coordinates in window space (1280x720).
+ * type: 0 = move, 1 = press, 2 = release, 3 = double click */
+extern "C" EMSCRIPTEN_KEEPALIVE
+void wasm_window_mouse_event(int type, int x, int y, int button)
+{
+    current_window_lock.lock();
+    vout_window_t *wnd = current_window;
+    if (wnd != nullptr)
+    {
+        switch (type)
+        {
+            case 0: vout_window_ReportMouseMoved(wnd, x, y); break;
+            case 1:
+                vout_window_ReportMouseMoved(wnd, x, y);
+                vout_window_ReportMousePressed(wnd, button);
+                break;
+            case 2: vout_window_ReportMouseReleased(wnd, button); break;
+            case 3: vout_window_ReportMouseDoubleClick(wnd, button); break;
+        }
+    }
+    current_window_lock.unlock();
+}
 
 //MAIN_THREAD_
 //EM_JS(emscripten::EM_VAL, GetCanvasSize, (), {
@@ -68,7 +102,11 @@ typedef struct emscripten_gl_sys_t
 static int OpenWindow(vout_window_t *wnd)
 {
     wnd->type = VOUT_WINDOW_TYPE_EMSCRIPTEN_WEBGL;
+    ops.destroy = DestroyWindow;
     wnd->ops = &ops;
+    current_window_lock.lock();
+    current_window = wnd;
+    current_window_lock.unlock();
     wnd->handle.canvas = "canvas";
 
     //emscripten::val size = GetCanvasSize();
@@ -180,6 +218,10 @@ static int Open (vlc_gl_t *gl, unsigned width, unsigned height)
             let canvasName = UTF8ToString($1);
             Module.canvasCtx = document.getElementById(canvasName).getContext('2d');
         }
+        /* Frames cover the whole surface (letterboxing included, possibly
+         * transparent): replace the canvas content instead of blending over
+         * the previous frame, which may have had another aspect ratio. */
+        Module.canvasCtx.globalCompositeOperation = 'copy';
         function onVoutMessage(msg) {
             let data = msg['data'];
             if (data.customCmd == 'commitFrame') {
